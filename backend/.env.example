# VisualVoice Backend Environment Variables
# Copy this to .env and fill in your values

# Primary Model - Your fine-tuned T5
# Option 1: Local path (after downloading from Kaggle)
MODEL_PATH=./models/t5-base-picto

# Option 2: Hugging Face Hub (recommended for hosting)
HF_MODEL_ID=your-username/visualvoice-t5-base
MODEL_TYPE=t5

# Fallback Reserve - Gemini Free API (use only when T5 accuracy low live)
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Or
GOOGLE_API_KEY=your_google_api_key_here

# Server
PORT=8000

# For future CLIP model
CLIP_FAISS_INDEX=./models/arasaac_clip_index.faiss
